#include <windows.h>
#include "resource.h"

/* id 1: loaded automatically - no comctl32 v6 dependency so it always starts in WinPE */
1 RT_MANIFEST "srsmgr.manifest"
/* id 2: activated at runtime only if comctl32 v6 is present (visual styles) */
IDR_STYLES RT_MANIFEST "styles.manifest"

IDI_APP  ICON   "srsmgr.ico"
IDB_BLUE BITMAP "banner_blue.bmp"
IDB_RED  BITMAP "banner_red.bmp"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904b0"
    BEGIN
      VALUE "CompanyName", "Steadier State (Windows 11 edition)"
      VALUE "FileDescription", "Image-O-Tron 11,000 - Steadier State boot manager"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "srsmgr"
      VALUE "OriginalFilename", "srsmgr.exe"
      VALUE "ProductName", "Image-O-Tron 11,000"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0809, 1200
  END
END
